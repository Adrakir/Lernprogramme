    {
      "role": "Gustav",
      "text": "Der Nullmeridian ist eine gedachte Linie von Pol zu Pol.",
      "start": 12.356666666666667,
      "end": 16.136666666666667
    },
    {
      "role": "Gustav",
      "text": "Er verläuft durch Greenwich bei London und hat null Grad geografische Länge.",
