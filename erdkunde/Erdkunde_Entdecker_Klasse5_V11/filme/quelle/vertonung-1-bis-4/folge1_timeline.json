  "cues": [
    {
      "role": "Paul",
      "text": "Herr Welt,   wie sieht unsere Erde eigentlich aus – und was ist in ihr drin?",
      "start": 0.35,
      "end": 5.67
    },
    {
      "role": "Herr Welt",
      "text": "Das zeigt uns Gustav Globus! Hallo Paul!",
      "start": 6.816666666666666,
      "end": 11.676666666666666
    },
    {
      "role": "Gustav",
      "text": "Unsere Erde ist fast kugelförmig.",
      "start": 12.956666666666667,
      "end": 15.536666666666667
    },
    {
      "role": "Gustav",
      "text": "An Nordpol und Südpol ist sie ein wenig abgeplattet.",
      "start": 15.956666666666667,
      "end": 19.316666666666666
    },
    {
      "role": "Gustav",
      "text": "Hier siehst du den Nordpol und dort den Südpol.",
      "start": 20.623333333333335,
      "end": 23.563333333333333
    },
    {
      "role": "Gustav",
      "text": "Die gedachte Linie dazwischen heißt Erdachse.",
      "start": 24.263333333333335,
      "end": 27.063333333333333
    },
    {
      "role": "Gustav",
      "text": "Schauen wir nun in die Erde hinein.",
      "start": 28.35666666666667,
      "end": 30.61666666666667
    },
    {
      "role": "Gustav",
      "text": "Außen liegt die dünne Erdkruste. Darunter der dicke Erdmantel.",
      "start": 31.89,
      "end": 36.75
    },
    {
      "role": "Gustav",
      "text": "Im Inneren liegt der Kern – außen flüssig, innen fest.",
      "start": 37.489999999999995,
      "end": 41.67
    },
    {
      "role": "Gustav",
      "text": "So sieht unser Erdaufbau schematisch aus.",
      "start": 42.95666666666667,
      "end": 45.99666666666667
    },
    {
      "role": "Paul",
      "text": "Wir leben auf der dünnen Erdkruste!",
      "start": 47.290000000000006,
      "end": 49.970000000000006
    },
    {
      "role": "Gustav",
      "text": "Genau! Im nächsten Film zeige ich dir, wie der Äquator die Erde teilt.",
      "start": 51.290000000000006,
      "end": 56.51050000000001
    }
  ],
