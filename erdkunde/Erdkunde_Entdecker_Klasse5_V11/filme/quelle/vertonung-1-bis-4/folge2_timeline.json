    {
      "role": "Paul",
      "text": "Gustav, warum hat die Erde eigentlich zwei Hälften?",
      "start": 0.49000000000000055,
      "end": 4.23
    },
    {
      "role": "Herr Welt",
      "text": "Zeig uns doch den Äquator, Gustav!",
      "start": 5.489999999999999,
      "end": 8.51
    },
    {
      "role": "Gustav",
      "text": "Das ist der Äquator: eine gedachte Linie rund um die Mitte der Erde.",
      "start": 9.793333333333331,
      "end": 14.693333333333332
    },
    {
      "role": "Gustav",
      "text": "Er liegt bei null Grad geografischer Breite.",
      "start": 15.433333333333332,
      "end": 18.313333333333333
    },
    {
      "role": "Gustav",
      "text": "Nördlich davon ist die Nordhalbkugel. Südlich davon die Südhalbkugel.",
      "start": 19.623333333333335,
      "end": 24.843333333333334
    },
    {
      "role": "Gustav",
      "text": "Die Erde bleibt eine Kugel;",
      "start": 26.156666666666666,
      "end": 27.836666666666666
    },
    {
      "role": "Gustav",
      "text": "der Äquator teilt sie nur gedanklich in zwei gleich große Hälften.",
      "start": 28.336666666666666,
      "end": 32.39666666666667
    },
    {
      "role": "Paul",
      "text": "Und wo liegt Deutschland?",
      "start": 33.69,
      "end": 34.92999999999999
    },
    {
      "role": "Gustav",
      "text": "Deutschland liegt nördlich des Äquators: Nordhalbkugel.",
      "start": 35.56999999999999,
      "end": 38.989999999999995
    },
    {
      "role": "Gustav",
      "text": "Australien liegt südlich des Äquators: Südhalbkugel.",
      "start": 40.29,
      "end": 43.89
    },
    {
      "role": "Gustav",
      "text": "Direkt am Äquator beträgt die geografische Breite null Grad.",
      "start": 45.156666666666666,
      "end": 49.35666666666666
    },
    {
      "role": "Gustav",
      "text": "Äquator gleich null Grad Breite.",
      "start": 49.75666666666667,
      "end": 52.236666666666665
    },
    {
      "role": "Paul",
      "text": "Liegt Australien nördlich oder südlich des Äquators?",
      "start": 53.556666666666665,
      "end": 57.39666666666666
    },
    {
